<!-- This adds the header to the home page -->
<%- include('partials/header', {title:'Home'}) %> 

<!-- This is the main container for the home page -->
<div class="container mt-5">

    <!-- This displays the welcome message -->
    <div class="text-center">
        <h1>My Portfolio</h1>
        
        <h2>Welcome to My Portfolio</h2>
        
        <p>Welcome to my portfolio website. This website showcases my projects and work completed during my studies.</p>


    </div>

    <hr>

    <!-- This provides links to other portfolio sections -->
    <h2 class="text-center">Explore My Portfolio</h2>

    <p class="text-center">Use the navigation above to explore different sections of my portfolio.</p>

    <div class="row mt-4"> <!-- This row contains three cards-->

        <!-- This is the "About Me" card -->
        <div class="col-md-4 mb-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h2>About Me</h2>
                    <p>Learn more about my background, skills, and experience.</p>
                    <a href="/about" class="btn btn-primary">Learn More</a>
                </div>
            </div>
        </div>

        <!-- This is the "My Projects" card -->
        <div class="col-md-4 mb-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h2>My Projects</h2>
                    <p>These are the projects and assignments I have completed during my studies.</p>
                    <a href="/projects" class="btn btn-primary">View Projects</a>
                </div>
            </div>
        </div>

        <!-- This is the "Contact Me" card -->
        <div class="col-md-4 mb-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h2>Contact Me</h2>
                    <p>Have a question or want to get in touch? Visit the Contact Me page.</p>
                    <a href="/contact" class="btn btn-primary">Contact Me</a>
                </div>
            </div>
        </div>
    </div>


<!--This adds the footer to the home page -->
<%- include('partials/footer') %>



  
